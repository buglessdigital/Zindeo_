@startuml
!include style.iuml
left to right direction
skinparam nodesep 40

class Recognition {
  createdAt : DateTime
  engine : RecognitionEngine
  modelVersion : String
  status : RecognitionStatus
  photoReference : String [0..1]
  durationMs : Integer
  costUsd : Decimal [0..1]
}
class RecognitionItem {
  position : Integer
  estimatedGrams : Decimal
  finalGrams : Decimal [0..1]
  wasCorrected : Boolean
}
class Candidate {
  rank : Integer
  confidence : Decimal
}
class DailyRecognitionUsage {
  usageDate : Date
  count : Integer
}
class Subscription {
  platform : StorePlatform
  productId : String
  originalTransactionId : String {unique}
  status : SubscriptionStatus
  expiresAt : DateTime
}
class Consent {
  type : ConsentType
  textVersion : String
  granted : Boolean
  recordedAt : DateTime
}
class UserAccount <<from Figure 5.3>>
class Food <<from Figure 5.2>>
class MealEntry <<from Figure 5.3>>

UserAccount "1" *-- "*" Recognition
UserAccount "1" *-- "*" DailyRecognitionUsage
UserAccount "1" *-- "*" Subscription
UserAccount "1" *-- "*" Consent
Recognition "1" *-- "*" RecognitionItem
RecognitionItem "1" *-- "1..*" Candidate : ordered by\nconfidence
Candidate "*" -- "1" Food
RecognitionItem "*" -- "0..1" Food : finalFood
RecognitionItem "0..1" -- "0..*" MealEntry : results in >
note bottom of Consent
Records are only added, never changed.
The current decision is the latest
record of each type (FR-11.4).
end note
note bottom of Recognition
photoReference is set only when
training-photo consent is granted
at recognition time (FR-11.2).
end note
@enduml
